# =============================================================================
# Alexandria Runtime — Environment Configuration Template
# Copy to .env or set in your environment
# =============================================================================

# Logging verbosity: trace | debug | info | warn | error
ALEXANDRIA_LOG_LEVEL=info

# Enforce strict TDD red phase verification before allowing GREEN code in src/
ALEXANDRIA_STRICT_TDD=true

# Optional override for the SQLite WAL database path
# By default, Alexandria resolves to <workspace_root>/.alexandria/vault.db for project isolation
# ALEXANDRIA_VAULT_DB=/custom/path/to/vault.db

# Optional custom directory for procedural capsules
# ALEXANDRIA_CAPSULES_DIR=.alexandria/capsules
