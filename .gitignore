# =====================================================================
# ALEXANDRIA RUNTIME — .gitignore (Public Repository Security Policy)
# =====================================================================

# 1. Secrets, Credentials, and Environment (CRITICAL: Zero leaks in public repos)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
~/.alexandria/
.alexandria/
alexandria-worktrees/
.alexandria-worktrees/

# 2. Private Local Vault & Internal Agent Scaffolding (Never publish to GitHub)
alexandria/
alexandria/**
.agents/
.agents/**
AGENTS.md
GEMINI.md
working.md

# 3. Local Databases & Control Cache
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 4. Rust Compilation Artifacts (Cargo.lock is tracked for reproducible binary builds)
target/
**/*.rs.bk

# 5. Node/TypeScript Dependencies, Logs, and Coverage
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
dist/
build/
.next/
out/
alexandria-vitest-report.json

# 6. Temporary & OS Files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~
.idea/
.vscode/
