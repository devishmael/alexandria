{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlexandriaSessionCheckpointJson",
  "type": "object",
  "required": [
    "checkpointId",
    "createdAt",
    "activeModule",
    "testStatus"
  ],
  "properties": {
    "checkpointId": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer"
    },
    "activeModule": {
      "type": "string"
    },
    "testStatus": {
      "type": "string"
    },
    "modifiedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summaryMarkdown": {
      "type": "string"
    }
  }
}
